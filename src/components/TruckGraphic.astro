---
// A cargo truck for "supply chain" — a long box trailer with a distinct
// cab-over tractor, not a boxy van (which reads as an ambulance).
---

<figure class="truck" role="img" aria-label="Line drawing of a cargo truck pulling a boxed trailer, representing software supply chain">
	<svg viewBox="0 0 260 140" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<path d="M6 110 H 254" class="ground" />

		<!-- long cargo box -->
		<rect x="18" y="42" width="150" height="60" class="stroke" />
		<rect x="34" y="58" width="34" height="28" class="crate" />
		<path d="M34 72 H 68" class="crate" />

		<!-- cab-over tractor, coupled with a small gap -->
		<rect x="176" y="66" width="52" height="36" class="stroke" />
		<rect x="186" y="74" width="18" height="16" class="stroke mini" />

		<!-- wheels -->
		<circle cx="46" cy="110" r="11" class="wheel" />
		<circle cx="120" cy="110" r="11" class="wheel" />
		<circle cx="198" cy="110" r="11" class="wheel" />
		<circle cx="228" cy="110" r="11" class="wheel" />

		<path class="flow" d="M18 26 H 168" />
	</svg>
</figure>

<style>
	.truck {
		margin: 0;
		width: 100%;
	}

	svg {
		width: 100%;
		height: auto;
	}

	.stroke,
	.mini {
		stroke: var(--ink-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.ground {
		stroke: var(--line);
		stroke-width: 1.5;
	}

	.crate {
		stroke: var(--copper);
		stroke-width: 1.4;
	}

	.wheel {
		fill: var(--paper-raised);
		stroke: var(--ink-soft);
		stroke-width: 1.5;
	}

	.flow {
		stroke: var(--teal);
		stroke-width: 1.3;
		stroke-dasharray: 4 5;
		opacity: 0.75;
	}

	@media (prefers-reduced-motion: no-preference) {
		.flow {
			animation: dash 4s linear infinite;
		}
	}

	@keyframes dash {
		to {
			stroke-dashoffset: -90;
		}
	}
</style>
