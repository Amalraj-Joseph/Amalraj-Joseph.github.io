---
const groups = [
	{ name: 'Languages', items: ['Java', 'Python', 'Shell'] },
	{ name: 'Platform', items: ['Kubernetes', 'OpenShift', 'Docker', 'Podman'] },
	{ name: 'Cloud', items: ['IBM Cloud', 'AWS'] },
	{ name: 'Backend', items: ['REST APIs', 'Microservices', 'Maven', 'WebSphere Liberty'] },
	{ name: 'Developer tooling', items: ['Git', 'GitHub', 'Jenkins', 'ArgoCD', 'Ansible'] },
];
---

<section class="section" id="skills">
	<div class="container">
		<p class="label">Skills</p>
		<h2 class="text-h2 heading">Working taxonomy</h2>

		<div class="groups">
			{
				groups.map((group) => (
					<div class="group">
						<h3 class="group-name">{group.name}</h3>
						<ul>
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.heading {
		margin-top: var(--space-3);
	}

	.groups {
		display: grid;
		gap: var(--space-6);
		margin-top: var(--space-6);
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
	}

	.group-name {
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.group ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}

	.group li {
		font-family: var(--font-display);
		font-size: 0.8rem;
		color: var(--ink);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		padding: var(--space-1) var(--space-3);
		background: var(--paper-raised);
	}
</style>
