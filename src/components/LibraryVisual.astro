---
// Shelfinity's small companion visual — a flat-roofed civic building with a
// book sign, drawn as an open line sketch (not a solid icon) so it reads as
// part of the page's blueprint system rather than a decorative sticker.
---

<figure class="library" role="img" aria-label="Line drawing of a small library building with a flat roof, columns, and a book sign">
	<svg viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<path d="M20 146 H 180" class="ground" />

		<!-- open book sign above the roofline -->
		<path d="M92 30 C 92 26, 100 24, 100 28 C 100 24, 108 26, 108 30 V 40 C 108 36, 100 34, 100 38 C 100 34, 92 36, 92 40 Z" class="book" />
		<path class="flow" d="M100 40 V 54" />

		<!-- flat roof -->
		<rect x="36" y="54" width="128" height="10" class="stroke" />

		<!-- columns -->
		<path d="M50 64 V 128 M 74 64 V 128 M 98 64 V 128 M 122 64 V 128 M 146 64 V 128" class="column" />

		<!-- base -->
		<rect x="30" y="128" width="140" height="10" class="stroke" />
		<rect x="22" y="138" width="156" height="8" class="stroke" />

		<!-- door -->
		<rect x="90" y="96" width="20" height="32" class="stroke" />
	</svg>
</figure>

<style>
	.library {
		margin: 0;
		width: 100%;
		display: flex;
		justify-content: center;
	}

	svg {
		width: 78%;
		height: auto;
	}

	.stroke,
	.column {
		stroke: var(--ink-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.column {
		stroke: var(--line-strong);
	}

	.ground {
		stroke: var(--line);
		stroke-width: 1.5;
	}

	.book {
		stroke: var(--copper);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}

	.flow {
		stroke: var(--teal);
		stroke-width: 1.3;
		stroke-dasharray: 3 4;
		opacity: 0.8;
	}

	@media (prefers-reduced-motion: no-preference) {
		.flow {
			animation: rise 3.5s ease-in-out infinite;
		}
	}

	@keyframes rise {
		0%,
		100% {
			opacity: 0.2;
		}
		50% {
			opacity: 0.9;
		}
	}
</style>
