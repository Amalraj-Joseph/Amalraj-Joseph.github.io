---
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="writing">
	<div class="container">
		<p class="label">Writing</p>
		<h2 class="text-h2 heading">Publications</h2>

		<ul class="shelf">
			{
				publications.map((pub) => (
					<li class="entry">
						<a class="entry-link" href={pub.data.url} target="_blank" rel="noopener noreferrer">
							<span class="entry-top">
								<span class="entry-title">{pub.data.title}</span>
								<span class="entry-year">{pub.data.year}</span>
							</span>
							<span class="entry-desc">{pub.data.description}</span>
							<span class="entry-meta">
								{pub.data.venue} · {pub.data.type === 'paper' ? 'Paper' : 'Article'} ↗
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.heading {
		margin-top: var(--space-3);
	}

	.shelf {
		margin-top: var(--space-6);
		display: grid;
	}

	.entry + .entry {
		border-top: 1px dashed var(--line);
	}

	.entry-link {
		display: block;
		text-decoration: none;
		color: inherit;
		padding-block: var(--space-5);
		transition: padding-inline 0.15s ease, background 0.15s ease;
	}

	.entry-link:hover {
		background: color-mix(in srgb, var(--paper-raised) 70%, transparent);
		padding-inline: var(--space-3);
	}

	.entry-top {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		align-items: baseline;
	}

	.entry-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
		max-width: 52ch;
	}

	.entry-year {
		font-family: var(--font-display);
		font-size: 0.85rem;
		color: var(--ink-faint);
		white-space: nowrap;
	}

	.entry-desc {
		display: block;
		margin-top: var(--space-2);
		color: var(--ink-soft);
		max-width: 60ch;
	}

	.entry-meta {
		display: block;
		margin-top: var(--space-3);
		font-family: var(--font-display);
		font-size: 0.8rem;
		color: var(--teal-strong);
	}
</style>
