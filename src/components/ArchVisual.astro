---
// A small architecture sketch for Shelfinity: frontend, backend, its
// database, and Keycloak handling identity on the side.
---

<figure class="arch" role="img" aria-label="Diagram of Shelfinity's architecture: a React frontend calling a Jakarta EE backend, which reads and writes PostgreSQL and defers authentication to Keycloak">
	<svg viewBox="0 0 480 260" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<path class="line flow" d="M96 80 H 190" />
		<path class="line flow" d="M296 80 H 372" />
		<path class="line" d="M240 108 V 150" />
		<path class="line dim" d="M334 108 C 334 140, 300 158, 260 168" />

		<g class="node">
			<rect x="16" y="56" width="80" height="48" rx="4" />
			<text x="56" y="76" text-anchor="middle">React</text>
			<text x="56" y="92" text-anchor="middle" class="mini">frontend</text>
		</g>

		<g class="node node--accent">
			<rect x="190" y="56" width="106" height="48" rx="4" />
			<text x="243" y="76" text-anchor="middle">Jakarta EE</text>
			<text x="243" y="92" text-anchor="middle" class="mini">backend</text>
		</g>

		<g class="node">
			<rect x="372" y="56" width="92" height="48" rx="4" />
			<text x="418" y="76" text-anchor="middle">Keycloak</text>
			<text x="418" y="92" text-anchor="middle" class="mini">identity</text>
		</g>

		<g class="node node--data">
			<rect x="196" y="150" width="88" height="48" rx="4" />
			<text x="240" y="170" text-anchor="middle">Postgres</text>
			<text x="240" y="186" text-anchor="middle" class="mini">data</text>
		</g>
	</svg>
</figure>

<style>
	.arch {
		margin: 0;
		width: 100%;
	}

	svg {
		width: 100%;
		height: auto;
	}

	.line {
		stroke: var(--line-strong);
		stroke-width: 1.5;
		fill: none;
	}

	.line.dim {
		stroke: var(--line);
		stroke-dasharray: 3 4;
	}

	.line.flow {
		stroke: var(--teal);
		stroke-dasharray: 4 5;
		opacity: 0.8;
	}

	@media (prefers-reduced-motion: no-preference) {
		.line.flow {
			animation: dash 4s linear infinite;
		}
	}

	@keyframes dash {
		to {
			stroke-dashoffset: -90;
		}
	}

	.node rect {
		fill: var(--paper-raised);
		stroke: var(--ink);
		stroke-width: 1.4;
	}

	.node--accent rect {
		stroke: var(--copper);
	}

	.node--data rect {
		stroke-dasharray: 2 3;
	}

	.node text {
		font-family: var(--font-display);
		font-size: 13px;
		fill: var(--ink);
	}

	.node text.mini {
		font-size: 10px;
		fill: var(--ink-faint);
	}
</style>
