---
// Three plain, human touchstones for "where this work happens" — an office
// campus, a desk, a team — sketched in the site's own line-art style rather
// than as an abstract data diagram. No captions; the icons speak for
// themselves.
---

<div class="scene" aria-hidden="true">
	<figure class="icon">
		<svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M14 90 H 106" class="ground" />
			<rect x="18" y="52" width="20" height="38" class="stroke" />
			<rect x="42" y="34" width="24" height="56" class="stroke" />
			<rect x="70" y="46" width="20" height="44" class="stroke" />
			<path d="M24 60 H 32 M 24 70 H 32 M 24 80 H 32" class="wire mini" />
			<path d="M48 42 H 60 M 48 52 H 60 M 48 62 H 60 M 48 72 H 60" class="wire mini" />
			<path d="M76 54 H 84 M 76 64 H 84 M 76 74 H 84" class="wire mini" />
		</svg>
	</figure>

	<figure class="icon">
		<svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M10 84 H 110" class="stroke" />
			<path d="M18 84 V 92 M 102 84 V 92" class="stroke" />

			<!-- laptop -->
			<path d="M34 78 H 70 L 66 66 H 38 Z" class="stroke" />
			<rect x="36" y="46" width="30" height="20" rx="1.5" class="stroke" />
			<path d="M40 52 H 62 M 40 58 H 54" class="wire mini" />

			<!-- mug -->
			<path d="M78 70 H 90 V 80 C 90 83, 78 83, 78 80 Z" class="stroke" />
			<path d="M90 72 C 95 72, 95 78, 90 78" class="stroke mini" />

			<!-- flower in a small vase -->
			<path d="M18 80 H 26 V 74 H 18 Z" class="crate" />
			<path d="M22 74 V 58" class="wire" />
			<circle cx="22" cy="54" r="2" class="dot" />
			<circle cx="18.5" cy="56.5" r="2" class="dot" />
			<circle cx="25.5" cy="56.5" r="2" class="dot" />
			<circle cx="22" cy="58.5" r="2" class="dot" />
		</svg>
	</figure>

	<figure class="icon">
		<svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M14 84 C 14 66, 26 58, 38 58 C 50 58, 62 66, 62 84" class="stroke" />
			<circle cx="38" cy="40" r="14" class="stroke" />
			<path d="M64 84 C 64 70, 74 64, 84 64 C 94 64, 104 70, 104 84" class="stroke soft" />
			<circle cx="84" cy="50" r="11" class="stroke soft" />
		</svg>
	</figure>
</div>

<style>
	.scene {
		height: 100%;
		min-height: 20rem;
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
		align-items: center;
		gap: var(--space-6);
	}

	.icon {
		margin: 0;
		width: 100%;
		max-width: 11.5rem;
	}

	svg {
		width: 100%;
		height: auto;
	}

	.stroke {
		stroke: var(--ink-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.stroke.soft {
		stroke: var(--line-strong);
	}

	.ground {
		stroke: var(--line);
		stroke-width: 1.5;
	}

	.wire {
		stroke: var(--teal);
		stroke-width: 1.3;
		opacity: 0.7;
	}

	.wire.mini {
		stroke: var(--line-strong);
		opacity: 1;
	}

	.crate {
		stroke: var(--copper);
		stroke-width: 1.4;
	}

	.dot {
		fill: var(--copper);
	}

	@media (max-width: 859px) {
		.scene {
			display: none;
		}
	}
</style>
