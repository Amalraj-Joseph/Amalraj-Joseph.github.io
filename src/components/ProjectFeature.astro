---
import CubeVisual from './CubeVisual.astro';
import LibraryVisual from './LibraryVisual.astro';
import ArchVisual from './ArchVisual.astro';

interface Props {
	project: {
		id: string;
		data: {
			title: string;
			description: string;
			highlights?: string[];
			technologies: string[];
			github: string;
			demo?: string;
			docs?: string;
			year: string;
			visual?: 'cube' | 'architecture';
		};
	};
	index: number;
}

const { project, index } = Astro.props;
const { title, description, highlights, technologies, github, demo, docs, year, visual } = project.data;
const reversed = index % 2 === 1;
const figure = String(index + 1).padStart(2, '0');
const hasDiagram = visual === 'architecture';
---

<article class:list={['project', { reversed }]}>
	<div class="project-copy">
		<p class="label">Fig. {figure} — {year}</p>
		<h3 class="text-h2">{title}</h3>
		<p class="text-lead">{description}</p>

		{
			highlights && highlights.length > 0 && (
				<ul class="highlights">
					{highlights.map((point) => (
						<li>{point}</li>
					))}
				</ul>
			)
		}
	</div>

	<div class:list={['project-visual', { plain: visual === 'architecture' }]}>
		{visual === 'cube' ? <CubeVisual /> : <LibraryVisual />}
	</div>

	{
		hasDiagram && (
			<div class="project-diagram">
				<ArchVisual />
			</div>
		)
	}

	<div class="project-footer">
		<ul class="tech" aria-label={`Technologies used in ${title}`}>
			{technologies.map((tech) => (
				<li>{tech}</li>
			))}
		</ul>
		<div class="links">
			<a href={github} target="_blank" rel="noopener noreferrer">
				Source ↗<span class="visually-hidden"> (opens {title} on GitHub)</span>
			</a>
			{demo && (
				<a href={demo} target="_blank" rel="noopener noreferrer">
					Live ↗<span class="visually-hidden"> (opens {title} demo)</span>
				</a>
			)}
			{docs && (
				<a href={docs} target="_blank" rel="noopener noreferrer">
					Docs ↗<span class="visually-hidden"> (opens {title} documentation)</span>
				</a>
			)}
		</div>
	</div>
</article>

<style>
	.project {
		display: grid;
		gap: var(--space-6);
		align-items: center;
		padding-block: var(--space-7);
	}

	.project + .project {
		border-top: 1px dashed var(--line);
	}

	.highlights {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--space-5);
		max-width: 60ch;
	}

	.highlights li {
		position: relative;
		padding-left: var(--space-5);
		color: var(--ink-soft);
	}

	.highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		background: var(--teal);
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.tech li {
		font-family: var(--font-display);
		font-size: 0.75rem;
		color: var(--ink-soft);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		padding: var(--space-1) var(--space-3);
	}

	.links {
		display: flex;
		gap: var(--space-5);
		margin-top: var(--space-6);
	}

	.links a {
		font-family: var(--font-display);
		font-size: 0.9rem;
		text-decoration: none;
		color: var(--copper-strong);
		border-bottom: 1px solid transparent;
	}

	.links a:hover {
		border-color: var(--copper);
	}

	.project-visual {
		background: color-mix(in srgb, var(--paper-raised) 60%, transparent);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: var(--space-6);
		align-self: stretch;
		display: flex;
		align-items: center;
	}

	.project-visual.plain {
		background: none;
		border: none;
		padding: var(--space-4);
	}

	.project-copy {
		order: 1;
	}

	.project-visual {
		order: 2;
	}

	.project-diagram {
		order: 3;
	}

	.project-footer {
		order: 4;
	}

	.project.reversed .project-copy {
		order: 2;
	}

	.project.reversed .project-visual {
		order: 1;
	}

	@media (min-width: 860px) {
		.project {
			grid-template-columns: 1.1fr 0.9fr;
		}

		.project-diagram,
		.project-footer {
			grid-column: 1 / -1;
		}
	}
</style>
