---
// A small layered node diagram — input, hidden, output — standing in for
// the ML thread below: literal enough to mean something, quiet enough not
// to shout "AI" the generic way.
---

<figure class="net" role="img" aria-label="Diagram of a small neural network with an input layer, a hidden layer, and a single output node">
	<svg viewBox="0 0 220 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		{
			[30, 70, 110].map((y) => (
				<>
					<path d={`M40 ${y} L 110 50`} class="wire" />
					<path d={`M40 ${y} L 110 80`} class="wire" />
					<path d={`M40 ${y} L 110 110`} class="wire" />
				</>
			))
		}
		<path d="M110 50 L 180 80" class="wire out" />
		<path d="M110 80 L 180 80" class="wire out" />
		<path d="M110 110 L 180 80" class="wire out" />

		{[30, 70, 110].map((y) => <circle cx="40" cy={y} r="6" class="node in" />)}
		{[50, 80, 110].map((y) => <circle cx="110" cy={y} r="6" class="node hidden" />)}
		<circle cx="180" cy="80" r="7" class="node out" />
	</svg>
</figure>

<style>
	.net {
		margin: 0;
		width: 100%;
	}

	svg {
		width: 100%;
		height: auto;
	}

	.wire {
		stroke: var(--line-strong);
		stroke-width: 1;
		opacity: 0.55;
	}

	.wire.out {
		stroke: var(--teal);
		opacity: 0.7;
	}

	.node {
		fill: var(--paper-raised);
		stroke: var(--ink-soft);
		stroke-width: 1.4;
	}

	.node.hidden {
		stroke: var(--copper);
	}

	.node.out {
		stroke: var(--teal);
		stroke-width: 1.8;
	}
</style>
